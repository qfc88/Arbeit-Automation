# Example htpasswd entries for the admin surface.
#
# Replace this file with a real htpasswd before starting nginx:
#   htpasswd -c deploy/nginx/htpasswd admin
#   htpasswd    deploy/nginx/htpasswd analyst
#
# The file path inside the nginx container is /etc/nginx/htpasswd
# (mounted read-only by docker-compose.prod.yml).
#
# DO NOT commit the real htpasswd — it is listed in .gitignore.
admin:$apr1$REPLACE_ME$REPLACE_ME
